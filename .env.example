# Copy to .env (git-ignored) and fill in. Every person needs their own keys.
# CDSE account: https://dataspace.copernicus.eu  (free)
CDSE_USERNAME=
CDSE_PASSWORD=
# Sentinel Hub OAuth client on CDSE (dashboard: https://shapps.dataspace.copernicus.eu/dashboard -> User settings -> OAuth clients)
SH_CLIENT_ID=
SH_CLIENT_SECRET=
# CDSE S3 keys (https://eodata-s3keysmanager.dataspace.copernicus.eu) - only for the SNAP/full path
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
# ohsome API v2 key (free): https://account.heigit.org/signup
OHSOME_API_KEY=
# Hugging Face token (Kuro Siwo download, P2)
HF_TOKEN=
# Optional local dashboard storage; set to the prepared cache/output directories.
# CUTOFF_CACHE_DIR=C:/cutoff_data/cache
# CUTOFF_OUTPUT_DIR=C:/cutoff_data/dashboard_runs
